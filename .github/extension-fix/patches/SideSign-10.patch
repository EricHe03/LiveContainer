+    @Test
+    func appBundleLoadsExtensionsFromPlugInsAndExtensionsDirectories() throws {
+        let tempDir = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        let appURL = tempDir.appendingPathComponent("Sample.app")
+        let pluginsExtURL = appURL.appendingPathComponent("PlugIns/Widget.appex")
+        let extensionKitURL = appURL.appendingPathComponent("Extensions/CrashReporterExtension Production.appex")
+
+        try FileManager.default.createDirectory(at: pluginsExtURL, withIntermediateDirectories: true)
+        try FileManager.default.createDirectory(at: extensionKitURL, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: tempDir) }
+
+        func writeInfoPlist(at bundleURL: URL, bundleID: String, name: String) throws {
+            let plist: [String: Any] = [
+                "CFBundleIdentifier": bundleID,
+                "CFBundleName": name,
+                "CFBundleShortVersionString": "1.0",
+                "CFBundleVersion": "1",
+                "CFBundlePackageType": bundleURL.pathExtension == "appex" ? "XPC!" : "APPL"
+            ]
+            let data = try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0)
+            try data.write(to: bundleURL.appendingPathComponent("Info.plist"))
+        }
+
+        try writeInfoPlist(at: appURL, bundleID: "com.example.app", name: "Sample")
+        try writeInfoPlist(at: pluginsExtURL, bundleID: "com.example.app.widget", name: "Widget")
+        try writeInfoPlist(at: extensionKitURL, bundleID: "com.example.app.CrashReporterExtension", name: "CrashReporter")
+
+        let appBundle = try #require(AppBundle(fileURL: appURL))
+        let loadedIDs = Set(appBundle.appExtensions.map(\.bundleIdentifier))
+
+        #expect(loadedIDs == [
+            "com.example.app.widget",
+            "com.example.app.CrashReporterExtension"
+        ])
+    }
+
